{
  "name": "fvtt-module-template",
  "description": "Scaffolds a Foundry VTT v14+ module project (TypeScript, Vite, Svelte, Vitest, Playwright, semantic-release, Sphinx).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.0.0-rc.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "node generator/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:smoke": "node scripts/smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "handlebars": "^4.7.10",
    "prettier": "^3.9.6"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
