{
  "name": "@mondarth/create-fvtt-module",
  "version": "0.3.1",
  "description": "Scaffolds a Foundry VTT v14+ module project (TypeScript or JavaScript, Vite, Svelte or Lit, Vitest, Playwright, semantic-release, Sphinx).",
  "keywords": [
    "foundryvtt",
    "foundry-vtt",
    "fvtt",
    "module",
    "template",
    "scaffold",
    "create"
  ],
  "license": "MIT",
  "author": "Ulenar of Mondarth",
  "homepage": "https://github.com/ulenarofmondarth/create-fvtt-module#readme",
  "bugs": {
    "url": "https://github.com/ulenarofmondarth/create-fvtt-module/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ulenarofmondarth/create-fvtt-module.git"
  },
  "type": "module",
  "bin": {
    "create-fvtt-module": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.0.0-rc.7",
  "engines": {
    "node": ">=24"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog",
      "maxHeaderWidth": 72
    }
  },
  "scripts": {
    "generate": "node generator/cli.ts",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:smoke": "node scripts/smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "semantic-release"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "amaro": "^1.2.1",
    "handlebars": "^4.7.10",
    "prettier": "^3.9.6"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "5.0.4",
    "commitizen": "4.3.2",
    "commitlint-plugin-tense": "^1.0.10",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cz-conventional-changelog": "3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
