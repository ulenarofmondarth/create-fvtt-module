---
secrets:
  config_json:
    file: secrets.json

services:
  foundry:
    image: felddy/foundryvtt:${VERSION}
    hostname: localhost
    # The user Foundry VTT runs as, which must own ./data. The serve:vtt script passes its own.
    user: ${HOST_UID:-1000}:${HOST_GID:-1000}
    volumes:
      - type: bind
        source: ./data
        target: /data
      - type: bind
        source: ..
        target: /data/Data/modules/{{{moduleId}}}
    environment:
      - CONTAINER_PRESERVE_CONFIG=true
      - FOUNDRY_HOT_RELOAD=true
    ports:
      - target: 30000
        published: 30000
        protocol: tcp
    secrets:
      - source: config_json
        target: config.json
