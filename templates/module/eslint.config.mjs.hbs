import js from '@eslint/js';
import { defineConfig } from 'eslint/config';
import jsdoc from 'eslint-plugin-jsdoc';
import prettier from 'eslint-plugin-prettier/recommended';
{{#if svelte}}
import svelte from 'eslint-plugin-svelte';
{{/if}}
import globals from 'globals';
{{#if typescript}}
import ts from 'typescript-eslint';
{{else}}

// What the Foundry client defines globally. Add to this list as the module uses more of Foundry.
const foundry = Object.fromEntries(
  ['CONFIG', 'CONST', 'Hooks', 'User', 'canvas', 'foundry', 'game', 'ui'].map(name => [name, 'readonly']),
);
{{/if}}

export default defineConfig(
  {
    ignores: [
      '.vite-cache/',
      'coverage/',
      'dist/',
      'docs/_build/',
      'releases/',
      'tests/e2e/.data/',
      'tests/e2e/test-results/',
      'tests/e2e/playwright-report/',
    ],
  },
  js.configs.recommended,
{{#if typescript}}
  ts.configs.strictTypeChecked,
{{/if}}
{{#if svelte}}
  svelte.configs.recommended,
{{/if}}
{{#if typescript}}
  jsdoc.configs['flat/recommended-typescript-error'],
{{else}}
  jsdoc.configs['flat/recommended-error'],
{{/if}}
  {
{{#if typescript}}
    languageOptions: {
      globals: globals.node,
      parserOptions: {
        project: ['./tsconfig.test.json', './tsconfig.node.json'],
        tsconfigRootDir: import.meta.dirname,
{{#if svelte}}
        extraFileExtensions: ['.svelte'],
{{/if}}
      },
    },

    rules: {
      '@typescript-eslint/consistent-type-imports': 'error',
      '@typescript-eslint/no-unused-vars': ['error', { argsIgnorePattern: '^_' }],
      '@typescript-eslint/restrict-template-expressions': ['error', { allowBoolean: true, allowNumber: true }],
{{else}}
    languageOptions: { globals: globals.node },

    rules: {
      // Describe every parameter and return value; naming its type as well is optional.
      'jsdoc/require-param-type': 'off',
      'jsdoc/require-returns-type': 'off',
      'no-unused-vars': ['error', { argsIgnorePattern: '^_' }],
{{/if}}
      'no-shadow': [
        'error',
        {
          builtinGlobals: true,
          hoist: 'all',
          allow: ['document', 'event', 'name', 'parent', 'status', 'top'],
        },
      ],
    },
  },
  {
    // Module source runs in the Foundry client, where jQuery is still a global.
    files: ['src/**'],
{{#if typescript}}
    languageOptions: { globals: { ...globals.browser, ...globals.jquery } },
  },
{{#if svelte}}
  {
    files: ['**/*.svelte', '**/*.svelte.ts'],
    languageOptions: { parserOptions: { parser: ts.parser } },
  },
{{/if}}
  {
    // Assertions on mocked methods (`expect(obj.method)`) are safe; the rule cannot tell them from real unbound calls.
    files: ['tests/**'],
    rules: { '@typescript-eslint/unbound-method': 'off' },
  },
  {
    // Plain JS tool configs are not part of any TypeScript project.
    files: ['**/*.mjs', '**/*.js'],
    extends: [ts.configs.disableTypeChecked],
  },
{{else}}
    languageOptions: { globals: { ...globals.browser, ...globals.jquery, ...foundry } },
  },
  {
    // Functions the end-to-end tests pass to `page.evaluate` run in the Foundry client too.
    files: ['tests/e2e/**'],
    languageOptions: { globals: foundry },
  },
{{/if}}
  // Must stay last: turns off formatting rules that conflict with Prettier and reports Prettier diffs as errors.
  prettier,
);
