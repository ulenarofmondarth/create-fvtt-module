{
  "name": {{{json moduleId}}},
  "description": {{{json description}}},
  "license": "MIT",
  "private": true,
  "type": "module",
  "author": {{{json authorName}}},
  "contributors": [
    {{{json authorName}}}
  ],
  "packageManager": "pnpm@12.0.0-rc.7",
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog",
      "maxHeaderWidth": 72
    }
  },
{{#if typescript}}
  "types": "./dist/index.d.ts",
{{/if}}
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "vite build",
    "dev": "vite",
{{#if typescript}}
{{#if svelte}}
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
{{/if}}
{{/if}}
{{#if typescript}}
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
{{/if}}
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.{{{ext}}}",
    "e2e:packages": "node scripts/e2e/install-packages.{{{ext}}}",
    "e2e:server": "docker compose -f tests/e2e/compose.yaml up --detach --wait",
    "e2e:server:stop": "docker compose -f tests/e2e/compose.yaml down",
{{#if typescript}}
    "test": "vitest --typecheck --run",
{{else}}
    "test": "vitest --run",
{{/if}}
    "eslint": "eslint .",
    "prepare": "husky",
    "release": "semantic-release",
    "serve:vtt": "cd .foundryvtt && mkdir -p data/Data/modules/{{{moduleId}}} && docker compose up -d",
    "build:docs": "docker compose run --rm --user \"$(id -u):$(id -g)\" docs make html",
    "serve:docs": "docker run --rm --name docserver -d -p 8080:80 -v \"$(pwd)/docs/_build/html\":/usr/share/nginx/html:ro nginx",
    "devserve:docs": "docker compose run --rm --service-ports --user \"$(id -u):$(id -g)\" docs make livehtml",
{{#if typescript}}
    "prettier:format": "prettier --config .prettierrc.json --write \"./src/**/*.{ts,js,mjs,json,scss,css}\"",
{{else}}
    "prettier:format": "prettier --config .prettierrc.json --write \"./src/**/*.{js,mjs,json,scss,css}\"",
{{/if}}
    "lint-staged": "lint-staged",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
{{#if svelte}}
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
{{/if}}
{{#if typescript}}
{{#if svelte}}
    "@tsconfig/svelte": "^5.0.8",
{{/if}}
{{/if}}
{{#if typescript}}
    "@types/node": "^26.2.0",
{{/if}}
{{#if typescript}}
    "@typescript/native": "npm:typescript@^7.0.2",
{{/if}}
    "@vitest/coverage-v8": "^5.0.4",
    "autoprefixer": "^10.5.4",
    "commitizen": "4.3.2",
    "commitlint-plugin-tense": "^1.0.10",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^50.8.0",
{{#if lit}}
    "eslint-plugin-lit": "^2.3.1",
{{/if}}
    "eslint-plugin-prettier": "^5.5.6",
{{#if svelte}}
    "eslint-plugin-svelte": "^3.23.0",
{{/if}}
{{#if typescript}}
    "fvtt-types": "github:League-of-Foundry-Developers/foundry-vtt-types#main",
{{/if}}
    "globals": "^16.5.0",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
{{#if lit}}
    "lit": "^3.3.3",
{{/if}}
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
{{#if svelte}}
    "svelte": "^5.56.10",
{{/if}}
{{#if typescript}}
{{#if svelte}}
    "svelte-check": "^4.7.6",
{{/if}}
{{/if}}
{{#if svelte}}
    "svelte-preprocess": "^6.0.5",
{{/if}}
{{#if typescript}}
    "typescript": "npm:@typescript/typescript6",
{{/if}}
{{#if typescript}}
    "typescript-eslint": "^8.67.0",
{{/if}}
{{#if typescript}}
    "unplugin-dts": "^1.0.3",
{{/if}}
    "vite": "^6.4.3",
{{#if typescript}}
    "vite-tsconfig-paths": "^5.1.4",
{{/if}}
    "vitest": "^5.0.4",
    "zod": "^4.6.5"
  },
  "browserslist": [
    ">5%",
    "not IE 11"
  ]
}
