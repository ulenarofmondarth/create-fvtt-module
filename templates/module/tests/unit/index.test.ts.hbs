import { beforeEach, describe, expect, test, vi } from 'vitest';

import type { FoundryMockOptions } from './mocks/foundry';
import { installFoundryMocks } from './mocks/foundry';

/**
 * Install the Foundry mocks and load a fresh copy of the module entry point.
 * @param options - Mock state
 * @returns Handles to the installed mocks
 */
async function loadModule(options: FoundryMockOptions = {}) {
  const mocks = installFoundryMocks(options);
{{#if lit}}

  // A custom element can be defined only once on a page, but every test loads the module, and with it the components
  // it imports, afresh. Keep the first definition of each element rather than fail on the second.
  const define = customElements.define.bind(customElements);
  vi.spyOn(customElements, 'define').mockImplementation((tagName, elementClass, definitionOptions) => {
    if (!customElements.get(tagName)) define(tagName, elementClass, definitionOptions);
  });

{{/if}}
  vi.resetModules();
  await import('../../src/index');
  return mocks;
}

describe('module entry point', () => {
  beforeEach(() => {
    vi.spyOn(console, 'log').mockImplementation(() => undefined);
  });

  test('does nothing until Foundry fires init', async () => {
    const { hooks } = await loadModule();

    expect(hooks.once).toHaveBeenCalledExactlyOnceWith('init', expect.any(Function));
    expect(console.log).not.toHaveBeenCalled();
  });

  test('announces itself on init', async () => {
    const { hooks } = await loadModule();

    hooks.run('init');

    expect(console.log).toHaveBeenCalledExactlyOnceWith({{{ts (concat moduleId ' | Initializing')}}});
  });

  test('only initializes once', async () => {
    const { hooks } = await loadModule();

    hooks.run('init');
    hooks.run('init');

    expect(console.log).toHaveBeenCalledOnce();
  });
});
