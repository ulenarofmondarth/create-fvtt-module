import { defineConfig, devices } from '@playwright/test';

const SETUP = /.*\.setup\.{{{ext}}}/;

/**
 * Foundry VTT logs a console error, which fails the test, in a window smaller than 1024x768; the desktop device
 * presets are 1280x720.
 */
const VIEWPORT = { width: 1280, height: 800 };

/**
 * End-to-end tests against a real Foundry VTT server (see `compose.yaml`). They are meant to run in CI: one browser
 * project per runner, each with its own freshly started server.
 */
export default defineConfig({
  testDir: '.',
  outputDir: './test-results',
  // A Foundry user can only be logged in once, so tests must not run side by side.
  fullyParallel: false,
  workers: 1,
  forbidOnly: !!process.env.CI,
  retries: process.env.CI ? 1 : 0,
  timeout: 120_000,
  expect: { timeout: 15_000 },
  reporter: process.env.CI
    ? [
        ['github'],
        ['html', { outputFolder: './playwright-report', open: 'never' }],
        ['json', { outputFile: './test-results/results.json' }],
      ]
    : [['list'], ['html', { outputFolder: './playwright-report', open: 'never' }]],
  use: {
    baseURL: process.env.FOUNDRY_URL ?? 'http://localhost:30000',
    trace: 'retain-on-failure',
    screenshot: 'only-on-failure',
    video: 'retain-on-failure',
  },
  projects: [
    // Accepts the licence agreement, creates and launches the test world and enables the modules.
    { name: 'setup', testMatch: SETUP, use: { ...devices['Desktop Chrome'], viewport: VIEWPORT } },
    { name: 'chromium', testIgnore: SETUP, dependencies: ['setup'], use: { ...devices['Desktop Chrome'], viewport: VIEWPORT } },
    // Headless Firefox cannot create the WebGL context Foundry VTT needs. Headed, it renders WebGL in software, so it
    // opens a window, which needs a display: `pnpm test:e2e:xvfb` provides a virtual one, in CI and locally.
    {
      name: 'firefox',
      testIgnore: SETUP,
      dependencies: ['setup'],
      use: { ...devices['Desktop Firefox'], viewport: VIEWPORT, headless: false },
    },
    { name: 'webkit', testIgnore: SETUP, dependencies: ['setup'], use: { ...devices['Desktop Safari'], viewport: VIEWPORT } },
  ],
});
